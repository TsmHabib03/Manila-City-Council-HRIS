<?xml version="1.0" encoding="UTF-8"?>
<!-- Employee's Leave Card - City Council of Manila ledger (VL/SL earned, absence/undertime w/pay, balance). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Leave-Card" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

	<style name="Base" isDefault="true" fontName="Arial" fontSize="7"/>
	<style name="Cell" fontName="Arial" fontSize="7">
		<box leftPadding="2" rightPadding="2">
			<pen lineWidth="0.5"/>
		</box>
	</style>

	<parameter name="EMP_NAME" class="java.lang.String"/>
	<parameter name="FIRST_DAY_OF_SERVICE" class="java.lang.String"/>
	<parameter name="PREPARED_BY_NAME" class="java.lang.String"/>
	<parameter name="PREPARED_BY_TITLE" class="java.lang.String"/>
	<parameter name="CERTIFIED_BY_NAME" class="java.lang.String"/>
	<parameter name="CERTIFIED_BY_TITLE" class="java.lang.String"/>

	<field name="period" class="java.lang.String"/>
	<field name="particulars" class="java.lang.String"/>
	<field name="vlEarned" class="java.lang.String"/>
	<field name="vlDeducted" class="java.lang.String"/>
	<field name="vlBalance" class="java.lang.String"/>
	<field name="slEarned" class="java.lang.String"/>
	<field name="slDeducted" class="java.lang.String"/>
	<field name="slBalance" class="java.lang.String"/>
	<field name="remarks" class="java.lang.String"/>

	<pageHeader>
		<band height="92">
			<staticText>
				<reportElement x="0" y="0" width="555" height="10"/>
				<textElement textAlignment="Center"><font size="7"/></textElement>
				<text><![CDATA[Republic of the Philippines]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="10" width="555" height="11"/>
				<textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
				<text><![CDATA[CITY COUNCIL]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="21" width="555" height="10"/>
				<textElement textAlignment="Center"><font size="7"/></textElement>
				<text><![CDATA[Manila]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="33" width="555" height="14"/>
				<textElement textAlignment="Center"><font size="10" isBold="true"/></textElement>
				<text><![CDATA[Employee's Leave Card]]></text>
			</staticText>

			<staticText>
				<reportElement x="0" y="52" width="45" height="12"/>
				<textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
				<text><![CDATA[NAME]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="45" y="52" width="290" height="12"/>
				<box><bottomPen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{EMP_NAME}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="345" y="52" width="115" height="12"/>
				<textElement verticalAlignment="Middle" textAlignment="Right"><font size="7" isBold="true"/></textElement>
				<text><![CDATA[FIRST DAY OF SERVICE  ]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="460" y="52" width="95" height="12"/>
				<box><bottomPen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
				<textFieldExpression><![CDATA[$P{FIRST_DAY_OF_SERVICE}]]></textFieldExpression>
			</textField>

			<!-- column headers -->
			<staticText>
				<reportElement style="Cell" x="0" y="68" width="50" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[PERIOD]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="50" y="68" width="105" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[PARTICULARS]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="155" y="68" width="135" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[VACATION LEAVE]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="290" y="68" width="135" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[SICK LEAVE]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="425" y="68" width="130" height="24"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<text><![CDATA[REMARKS
(date/s of leave)]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="155" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
				<text><![CDATA[EARNED]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="200" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="5.5" isBold="true"/></textElement>
				<text><![CDATA[Abs./UT w/pay]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="245" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
				<text><![CDATA[BALANCE]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="290" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
				<text><![CDATA[EARNED]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="335" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="5.5" isBold="true"/></textElement>
				<text><![CDATA[Abs./UT w/pay]]></text>
			</staticText>
			<staticText>
				<reportElement style="Cell" x="380" y="80" width="45" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6" isBold="true"/></textElement>
				<text><![CDATA[BALANCE]]></text>
			</staticText>
		</band>
	</pageHeader>

	<detail>
		<band height="12" splitType="Prevent">
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="0" y="0" width="50" height="12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{period}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement style="Cell" x="50" y="0" width="105" height="12"/>
				<textElement verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{particulars}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="155" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{vlEarned}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="200" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{vlDeducted}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="245" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{vlBalance}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="290" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{slEarned}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="335" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{slDeducted}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement style="Cell" x="380" y="0" width="45" height="12"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="6.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{slBalance}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true" isStretchWithOverflow="true">
				<reportElement style="Cell" x="425" y="0" width="130" height="12"/>
				<textElement verticalAlignment="Middle"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$F{remarks}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<summary>
		<band height="70">
			<staticText>
				<reportElement x="10" y="18" width="120" height="10"/>
				<textElement><font size="7" isBold="true"/></textElement>
				<text><![CDATA[PREPARED BY:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="10" y="40" width="200" height="11"/>
				<box><bottomPen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Bottom"><font size="7.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{PREPARED_BY_NAME}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="10" y="52" width="200" height="10"/>
				<textElement textAlignment="Center"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$P{PREPARED_BY_TITLE}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="300" y="18" width="150" height="10"/>
				<textElement><font size="7" isBold="true"/></textElement>
				<text><![CDATA[CERTIFIED CORRECT:]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="40" width="200" height="11"/>
				<box><bottomPen lineWidth="0.5"/></box>
				<textElement textAlignment="Center" verticalAlignment="Bottom"><font size="7.5" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{CERTIFIED_BY_NAME}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="300" y="52" width="200" height="10"/>
				<textElement textAlignment="Center"><font size="6.5"/></textElement>
				<textFieldExpression><![CDATA[$P{CERTIFIED_BY_TITLE}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
